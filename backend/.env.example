# ==============================================================================
# GrievAI Backend Production Environment Variables
# ==============================================================================

# Project & Environment
PROJECT_NAME=GrievAI
ENVIRONMENT=production
PORT=8000

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_your_super_secret_production_key_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Database (Supabase PostgreSQL with pgvector)
# Direct connection / Transaction Pooler:
DATABASE_URL=postgresql+psycopg://postgres.pwaczzkywwwfrohzzkjl:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# AI / Embedding Microservice (Ollama remote instance or local)
# Leave as fallback default if using built-in deterministic offline engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=15.0

# CORS Whitelist (Comma-separated for frontend domains)
CORS_ORIGINS=https://griev-ai.vercel.app,https://your-custom-domain.com,http://localhost:3000,http://localhost:5173

# File Evidence Storage Directory
EVIDENCE_STORAGE_DIR=storage/evidence
