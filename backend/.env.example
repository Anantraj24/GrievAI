# GrievAI Environment Configuration Example
PROJECT_NAME="GrievAI"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL="postgresql+psycopg://grievai_user:grievai_password@localhost:5432/grievai_db"

# JWT Security
SECRET_KEY="generate_a_secure_random_hex_key_here_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Ollama Service
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3"
OLLAMA_EMBED_MODEL="bge-m3"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage
EVIDENCE_STORAGE_DIR="storage/evidence"
